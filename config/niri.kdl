// -- No client-side decorations --
prefer-no-csd
// -- Disable saving screenshots to disk --
// screenshot-path null
// -- Startup services --
spawn-sh-at-startup "awww-daemon & while ! awww query > /dev/null 2>&1; do sleep 0.1; done && awww img /home/tangerine/.dotfiles/config/anime_skull.png --transition-type none"
// -- Keybinds --
binds {
    // -- Spawn applications --
    Mod+B hotkey-overlay-title="Chromium: Web Browser" {
        spawn "chromium"
    }
    Mod+E hotkey-overlay-title="Yazi: File Explorer" {
        spawn "ghostty" "-e" "yazi"
    }
    Mod+V hotkey-overlay-title="ClipHist: Clipboard Manager" {
        spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"
    }
    Mod+Escape hotkey-overlay-title="Bottom: Process Viewer" {
        spawn "ghostty" "-e" "btm"
    }
    Mod+Period hotkey-overlay-title="Smile: Emoji Picker" {
        spawn "smile"
    }
    Mod+Return hotkey-overlay-title="Ghostty: Terminal Emulator" {
        spawn "ghostty"
    }
    Mod+Space hotkey-overlay-title="Fuzzel: Application Launcher" {
        spawn "fuzzel"
    }
    // -- Misc --
    Mod+F hotkey-overlay-title="Maximize Focused Window" {
        fullscreen-window
    }
    Mod+Q {
        close-window
    }
    Mod+R {
        switch-preset-column-width
    }
    Mod+Equal hotkey-overlay-title="Increase Focused Window Width" {
        set-column-width "+5%"
    }
    Mod+Minus hotkey-overlay-title="Decrease Focused Window Width" {
        set-column-width "-5%"
    }
    Mod+Shift+R hotkey-overlay-title="Set Focused Window Width to 50%" {
        set-column-width "50%"
    }
    Mod+Shift+V {
        toggle-window-floating
    }
    Mod+Shift+Slash {
        show-hotkey-overlay
    }
    // -- Manage session --
    Mod+Alt+L hotkey-overlay-title="Lock Session" {
        spawn "swaylock" "-f"
    }
    Mod+Alt+S hotkey-overlay-title="Suspend Session" {
        spawn "sh" "-c" "swaylock -f && systemctl suspend"
    }
    Mod+Alt+E {
        quit
    }
    // -- Quick controls --
    Print {
        screenshot
    }
    XF86AudioRaiseVolume {
        spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "0.05+"
    }
    XF86AudioLowerVolume {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"
    }
    XF86AudioMute allow-when-locked=true {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"
    }
    XF86MonBrightnessUp allow-when-locked=true {
        spawn "brightnessctl" "set" "10%+"
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "brightnessctl" "set" "10%-"
    }
}
// -- Mouse cursor settings
cursor {
    hide-when-typing
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}
// -- Gestures --
gestures {
    hot-corners {
        off
    }
}
// -- Prevent Niri from showing default hotkeys on startup
hotkey-overlay {
    skip-at-startup
}
// -- Input settings --
input {
    touchpad {
        accel-speed 0.8
        natural-scroll
        tap
    }
}
// -- Application-specific layer rules --
layer-rule {
    match namespace="^launcher$"
    geometry-corner-radius 16
    opacity 0.9
    background-effect {
        blur true
        saturation 2
        xray false
    }
    shadow {
        on
    }
}
// -- Window layout rules --
layout {
    always-center-single-column
    gaps 8
    border {
        active-color "#83a59822"
        inactive-color "#1d202122"
        width 6
    }
    default-column-width {
        proportion 0.8
    }
    focus-ring {
        off
    }
    insert-hint {
        color "83a59880"
    }
    shadow {
        on
    }
    preset-column-widths {
        proportion 1.0
        proportion 0.8
        proportion 0.5
    }
}
// -- Monitor settings --
output "eDP-1" {
    scale 1.0
}
// -- Overview settings --
overview {
    backdrop-color "#111111"
}
// -- Window switcher settings --
recent-windows {
    binds {
        Mod+Tab {
            next-window
        }
        Mod+grave {
            previous-window
        }
    }
    highlight {
        active-color "#83a598aa"
        corner-radius 10
    }
}
// -- Global window rules --
window-rule {
    clip-to-geometry true
    draw-border-with-background false
    geometry-corner-radius 10
    background-effect {
        blur true
        noise 0.2
        saturation 3
        xray true
    }
}
// -- Application-specific window rules --
window-rule {
    exclude app-id="imv"
    exclude app-id="mpv"
    exclude app-id="org.gnome.Snapshot"
    exclude app-id="chromium" title="YouTube"
    exclude app-id="youtube"
    opacity 0.95
}
window-rule {
    match app-id="smile"
    open-floating true
    default-column-width {
        fixed 400
    }
    default-window-height {
        fixed 490
    }
}

