include "noctalia.kdl"
include "~/.cache/noctalia/niri.kdl"
// -- No client-side decorations --
prefer-no-csd
debug {
    // Allows notification actions and window activation from Noctalia.
    honor-xdg-activation-with-invalid-serial
}
// -- Disable saving screenshots to disk --
// screenshot-path null
// -- Startup services --
spawn-at-startup "noctalia"
// -- Keybinds --
binds {
    // -- Spawn applications --
    Mod+B hotkey-overlay-title="Zen: Web Browser" {
        spawn "zen-beta"
    }
    Mod+E hotkey-overlay-title="Nautilus: File Explorer" {
        spawn "nautilus"
    }
    Mod+V hotkey-overlay-title="Noctalia: Clipboard Manager" {
        spawn-sh "noctalia msg panel-toggle clipboard"
    }
    Mod+Escape hotkey-overlay-title="Bottom: Process Viewer" {
        spawn "ghostty" "-e" "btop"
    }
    Mod+Period hotkey-overlay-title="Smile: Emoji Picker" {
        spawn "smile"
    }
    Mod+Return hotkey-overlay-title="Ghostty: Terminal Emulator" {
        spawn "ghostty"
    }
    Mod+Space hotkey-overlay-title="Noctalia: Application Launcher" {
        spawn-sh "noctalia msg panel-toggle launcher"
    }
    // -- Misc --
    Mod+A hotkey-overlay-title="Noctalia: Control Center" {
        spawn-sh "noctalia msg panel-toggle control-center"
    }
    Mod+Comma hotkey-overlay-title="Noctalia: Settings" {
        spawn-sh "noctalia msg settings-toggle"
    }
    Mod+F hotkey-overlay-title="Maximize Focused Window" {
        fullscreen-window
    }
    Mod+H {
        focus-column-left
    }
    Mod+J {
        focus-workspace-down
    }
    Mod+K {
        focus-workspace-up
    }
    Mod+L {
        focus-column-right
    }
    Mod+Q {
        close-window
    }
    Mod+R {
        switch-preset-column-width
    }
    Mod+W {
        toggle-overview
    }
    Mod+Equal hotkey-overlay-title="Focused Window Width +5%" {
        set-column-width "+5%"
    }
    Mod+Minus hotkey-overlay-title="Focused Window Width -5%" {
        set-column-width "-5%"
    }
    Mod+Shift+H {
        move-column-left
    }
    Mod+Shift+J {
        move-window-to-workspace-down
    }
    Mod+Shift+K {
        move-window-to-workspace-up
    }
    Mod+Shift+L {
        move-column-right
    }
    // idk why this is needed
    Mod+Shift+R hotkey-overlay-title="Set Focused Window Width to 50%" {
        set-column-width "50%"
    }
    Mod+Shift+V {
        toggle-window-floating
    }
    Mod+Shift+Slash {
        show-hotkey-overlay
    }
    // -- Manage session --
    Mod+Alt+L hotkey-overlay-title="Lock Session" {
        spawn-sh "noctalia msg session lock"
    }
    Mod+Alt+S hotkey-overlay-title="Lock and Suspend" {
        spawn-sh "noctalia msg session lock-and-suspend"
    }
    Mod+Alt+E {
        quit
    }
    // -- Quick controls --
    Print {
        spawn-sh "noctalia msg screenshot-region"
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "noctalia msg volume-down"
    }
    XF86AudioMute allow-when-locked=true {
        spawn-sh "noctalia msg volume-mute"
    }
    XF86AudioPlay allow-when-locked=true {
        spawn-sh "noctalia msg media toggle"
    }
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "noctalia msg volume-up"
    }
    XF86MonBrightnessUp allow-when-locked=true {
        spawn-sh "noctalia msg brightness-up"
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn-sh "noctalia msg brightness-down"
    }
}
// -- Mouse cursor settings
cursor {
    hide-when-typing
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}
// -- Gestures --
gestures {
    hot-corners {
        off
    }
}
// -- Prevent Niri from showing default hotkeys on startup
hotkey-overlay {
    skip-at-startup
}
// -- Input settings --
input {
    touchpad {
        accel-speed 0.8
        natural-scroll
        tap
    }
}
// -- Application-specific layer rules --
layer-rule {
    exclude namespace="^noctalia-"
    background-effect {
        blur true
        xray false
    }
    popups {
        background-effect {
            blur true
            xray false
        }
    }
}
// -- Noctalia: blurred overview backdrop (requires [backdrop] enabled in noctalia config) --
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}
layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}
// -- Window layout rules --
layout {
    always-center-single-column
    gaps 8
    border {
        width 3
    }
    default-column-width {
        proportion 0.8
    }
    focus-ring {
        off
    }
    shadow {
        on
    }
    preset-column-widths {
        proportion 1.0
        proportion 0.8
        proportion 0.5
    }
}
// -- Monitor settings --
output "eDP-1" {
    scale 1.0
}
// -- Window switcher settings --
recent-windows {
    highlight {
        corner-radius 8
    }
}
// -- Global window rules --
window-rule {
    clip-to-geometry true
    draw-border-with-background false
    geometry-corner-radius 12
    background-effect {
        blur true
        xray true
    }
}
// -- Application-specific window rules --
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width {
        fixed 1080
    }
    default-window-height {
        fixed 920
    }
}
window-rule {
    exclude app-id="imv"
    exclude app-id="mpv"
    exclude app-id="org.gnome.Snapshot"
    exclude app-id="chromium" title="Crunchyroll"
    exclude app-id="chromium" title="YouTube"
    exclude app-id="zed"
    exclude title="Crunchyroll"
    exclude title="YouTube"
    opacity 0.9
}
window-rule {
    match title="YouTube Music"
    opacity 0.9
}
window-rule {
    match app-id="smile"
    open-floating true
    default-column-width {
        fixed 400
    }
    default-window-height {
        fixed 490
    }
}
window-rule {
    match app-id="zed" title="Settings"
    open-floating true
    background-effect {
        xray false
    }
}
