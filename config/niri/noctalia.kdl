layout {

    focus-ring {
        active-color   "#83d5c6"
        inactive-color "#0e1513"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#83d5c6"
        inactive-color "#0e1513"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#83d5c6"
        inactive-color "#005047"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#83d5c680"
    }
}

recent-windows {
    highlight {
        active-color "#83d5c6"
        urgent-color "#ffb4ab"
    }
}
