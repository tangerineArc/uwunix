layout {

    focus-ring {
        active-color   "#95cdf7"
        inactive-color "#101417"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#95cdf7"
        inactive-color "#101417"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#95cdf7"
        inactive-color "#004b6f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#95cdf780"
    }
}

recent-windows {
    highlight {
        active-color "#95cdf7"
        urgent-color "#ffb4ab"
    }
}
