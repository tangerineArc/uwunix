layout {

    focus-ring {
        active-color   "#94cdf7"
        inactive-color "#101417"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#94cdf7"
        inactive-color "#101417"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#94cdf7"
        inactive-color "#004c6e"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#94cdf780"
    }
}

recent-windows {
    highlight {
        active-color "#94cdf7"
        urgent-color "#ffb4ab"
    }
}
