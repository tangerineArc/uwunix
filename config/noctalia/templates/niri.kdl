layout {
    border {
        active-color "{{colors.primary.default.hex}}22"
        inactive-color "{{colors.outline.default.hex}}22"
        urgent-color "{{colors.error.default.hex}}22"
    }
    insert-hint {
        color "{{colors.primary.default.hex}}80"
    }
}
overview {
    backdrop-color "{{colors.background.default.hex}}"
}
recent-windows {
    highlight {
        active-color "{{colors.tertiary_container.default.hex}}aa"
    }
}

